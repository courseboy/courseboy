// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppUser {
  id        Int       @id @default(autoincrement())
  username  String?
  email     String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  lastLogin DateTime? @map("last_login")

  // Relations
  userSecret      UserSecret?
  userPrivileges  UserPrivilege[]
  certificates    Certificate[]
  courseFeedbacks CourseFeedback[]
  quizSubmissions QuizSubmission[]
  userAccesses    UserAccess[]

  @@map("app_user")
}

model Privilege {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  price       Int?

  // Relations
  userPrivileges UserPrivilege[]
  courses        Course[]

  @@map("privilege")
}

model UserPrivilege {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  privilegeId Int      @map("privilege_id")
  createAt    DateTime @default(now()) @map("create_at")

  // Relations
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  privilege Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@unique([userId, privilegeId])
  @@map("user_privilege")
}

model UserSecret {
  userId       Int       @id @map("user_id")
  passwordHash String?   @map("password_hash")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  // Relations
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_secret")
}

model Course {
  id                     Int       @id @default(autoincrement())
  name                   String?
  coverImg               String?   @map("cover_img")
  description            String?
  requiredPrivilegeId    Int?      @map("required_privilege_id")
  isPublished            Boolean   @default(false) @map("is_published")
  certificateTemplateUrl String?   @map("certificate_template_url")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime? @updatedAt @map("updated_at")

  // Relations
  requiredPrivilege Privilege?       @relation(fields: [requiredPrivilegeId], references: [id])
  courseCategories  CourseCategory[]
  lessons           Lesson[]
  certificates      Certificate[]
  courseFeedbacks   CourseFeedback[]

  @@map("course")
}

model CourseCategory {
  id         Int    @id @default(autoincrement())
  courseId   Int    @map("course_id")
  name       String
  orderIndex Int    @default(0) @map("order_index")

  // Relations
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]

  @@map("course_category")
}

model Lesson {
  id               Int       @id @default(autoincrement())
  courseId         Int       @map("course_id")
  courseCategoryId Int?      @map("course_category_id")
  title            String?
  videoUrl         String?   @map("video_url")
  lastWatchDate    DateTime? @map("last_watch_date")
  durationSeconds  Int?      @map("duration_seconds")
  orderIndex       Int       @default(0) @map("order_index")
  isFreePreview    Boolean   @default(false) @map("is_free_preview")

  // Relations
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseCategory CourseCategory? @relation(fields: [courseCategoryId], references: [id])
  userAccesses   UserAccess[]

  @@map("lesson")
}

model Certificate {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  courseId        Int      @map("course_id")
  certificateCode String   @unique @map("certificate_code")
  fileUrl         String?  @map("file_url")
  issuedAt        DateTime @default(now()) @map("issued_at")

  // Relations
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("certificate")
}

model CourseFeedback {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  userId    Int      @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("course_feedback")
}

model Quiz {
  id               Int     @id @default(autoincrement())
  courseCategoryId Int     @map("course_category_id")
  name             String
  description      String?
  passingScore     Int     @default(70) @map("passing_score") // Percentage to pass
  timeLimit        Int?    @map("time_limit") // Time limit in minutes (null = no limit)

  // Relations
  courseCategory  CourseCategory   @relation(fields: [courseCategoryId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]
  quizSubmissions QuizSubmission[]

  @@map("quiz")
}

model QuizQuestion {
  id            Int      @id @default(autoincrement())
  quizId        Int      @map("quiz_id")
  questionText  String   @map("question_text")
  questionType  String   @default("multiple_choice") @map("question_type") // multiple_choice, true_false
  options       String[] // Array of option texts
  correctAnswer Int      @map("correct_answer") // Index of correct option (0-based)
  points        Int      @default(1)
  orderIndex    Int      @default(0) @map("order_index")

  // Relations
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_question")
}

model QuizSubmission {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  quizId      Int      @map("quiz_id")
  score       Int      // Score achieved
  maxScore    Int      @map("max_score") // Maximum possible score
  percentage  Int      // Score percentage
  passed      Boolean  @default(false)
  answers     Json?    // User's answers: { questionId: selectedOption }
  timeTaken   Int?     @map("time_taken") // Time taken in seconds
  submittedAt DateTime @default(now()) @map("submitted_at")

  // Relations
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_submission")
}

model UserAccess {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  lessonId       Int      @map("lesson_id")
  watchedSeconds Int      @default(0) @map("watched_seconds")
  isCompleted    Boolean  @default(false) @map("is_completed")
  lastAccessAt   DateTime @default(now()) @map("last_access_at")

  // Relations
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_access")
}
